    1  lsblk
    2  fdisk /dev/sdb
    3  mkfs.ext4 -L MEPHI_WEB /dev/sdb1
    4  mkdir -p /mephi-web
    5  blkid -o value -s LABEL /dev/sdb1
    6  mcedit /etc/fstab 
    7  mount -a
    8  systemctl deamon-reload
    9  stat /mephi-web
   10  stat /mephi-web >> ~/stat.out
   11  systemctl enable --now nginx
   12  journalctl -u nginx -b
   13  journalctl -u nginx -b > ~/journalctl.out
   14  groupadd -g 4444 curators
   15  useradd -u 5501 -G curators user1
   16  useradd -u 5502 -G curators user2
   17  useradd -u 5503 -G curators user3
   18  useradd -u 5504 curator1
   19  useradd -u 5505 curator2
   20  mkdir -p /data/mephi-2026
   21  chown root:curators /data/mephi-2026
   22  chmod 2770 /data/mephi-2026
   23  setcap cap_net_raw,cap_net_admin+eip /usr/sbin/tcpdump 
   24  getcap /usr/sbin/tcpdump > ~/getcap.out
   25  sudo -u user1 tcpdump -h
   26  getenforce
   27  getenforce > ~/getenfors.out
   28  semanage fcontext -a -t httpd_sys_content_t "/mephi-web(/.*)?"
   29  restorecon -Rv /mephi-web
